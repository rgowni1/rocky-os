# Copy to .env and fill in. Never commit the filled version.
# Every key here is also a GitHub Actions secret on rgowni1/rocky-os — if you
# add one, add it in both places or the scheduled run exits on its own
# "Missing environment variables:" guard.

# --- Supabase (source of truth) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
KANBAN_USER_ID=
# Local only, used by tools/run_sql.py. Supabase Dashboard > Project Settings >
# Database > Connection string > *Session pooler*. The direct db.<ref> host is
# IPv6-only and will not connect from this Mac.
SUPABASE_DB_URL=

# --- Notion ---
# The "Kanban" integration. Reads a strict superset of the old
# "WeeklyTrackingBot" token and has write capability.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_JOURNAL_DB_ID=
NOTION_DB_ID=
NOTION_LIFT_TRACKER_DB_ID=

# --- Sources ---
OURA_ACCESS_TOKEN=
READWISE_API_TOKEN=
GARMIN_EMAIL=
GARMIN_PASSWORD=
HEVY_API_KEY=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REFRESH_TOKEN=

# --- Destinations ---
BEEMINDER_USERNAME=
BEEMINDER_AUTH_TOKEN=
# Optional. Unset, sync/eow_digest.py prints the digest and exits 0.
SLACK_WEBHOOK_URL=

# --- Claude (journal High/Low/Bud generation) ---
ANTHROPIC_API_KEY=
